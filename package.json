    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "music-metadata": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
