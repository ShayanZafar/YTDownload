{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/index.cjs",
    "check": "tsc",
    "coverage": "vitest run tests/unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=reports/coverage --coverage.include=client/src/**/*.ts --coverage.include=client/src/**/*.tsx --coverage.include=server/**/*.ts --coverage.include=shared/**/*.ts --coverage.exclude=client/src/components/ui/**",
    "licenses": "tsx scripts/licenses.ts",
    "core-flows": "tsx scripts/core-flows.ts",
    "instructions": "tsx scripts/instructions.ts",
    "verify": "prettier --check . && eslint . && tsc && npm run licenses && npm run core-flows && npm run instructions && vitest run tests/unit tests/api/music.e2e.test.ts tests/api/history.e2e.test.ts",
    "e2e:live": "cross-env E2E_LIVE=1 playwright test --grep @live",
    "clean": "tsx scripts/clean.ts",
    "postinstall": "node scripts/yt-dlp.mjs",
    "update-yt-dlp": "node scripts/yt-dlp.mjs --update"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.54.0",
    "music-metadata": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0",
    "youtube-dl-exec": "^3.1.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "ffmpeg-static": true,
    "youtube-dl-exec": true
  }
}
