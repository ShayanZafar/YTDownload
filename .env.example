# Optional settings. Copy this file to `.env` and uncomment what you need —
# the app runs fine without a .env file. `.env` is git-ignored.

# Port to serve the app on (default 5000).
# PORT=5000

# Interface to listen on (default 127.0.0.1 = this computer only).
# Use 0.0.0.0 to reach it from other devices (e.g. your phone on the same Wi-Fi).
# HOST=127.0.0.1

# Extra host names the app answers to, comma-separated (localhost and IP
# addresses always work). Needed only for names like a Tailscale address.
# ALLOWED_HOSTS=my-pc.tail1234.ts.net

# Where to keep the download history (default data/history.json).
# HISTORY_FILE=data/history.json

# Where to keep the app's settings - the Save to folder (default data/settings.json).
# SETTINGS_FILE=data/settings.json

# Where to write the report of how YouTube and Spotify have been answering
# (default data/source-health.json; the same report is at /api/health/sources).
# SOURCE_HEALTH_FILE=data/source-health.json

# Where to keep the details log: each song Fill in details looked up or wrote, and
# each download, with what happened and why (default data/details.log; the newest
# lines are at /api/details-log).
# DETAILS_LOG_FILE=data/details.log

# Use a specific ffmpeg instead of the one downloaded by `npm install`.
# FFMPEG_BIN=C:\tools\ffmpeg\bin\ffmpeg.exe

# Where the music player keeps songs converted to FLAC (default yt-audio-player
# in the system's temp folder; up to 2 GB).
# PLAYER_CACHE_DIR=D:\Cache\yt-audio-player
