# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string (required).
# Examples:
#   Local install:  postgres://your-user@localhost:5432/youtube_audio
#   Docker:         postgres://postgres:postgres@localhost:5432/youtube_audio
#   Hosted (Neon):  postgres://user:password@ep-xxxx.neon.tech/youtube_audio?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/youtube_audio

# Optional. `development` (default) or `production`.
# NODE_ENV=development

# Optional. Port to bind the dev/production server (default 5000).
# PORT=5000

# Optional. Interface to listen on (default 127.0.0.1 = this computer only).
# Use 0.0.0.0 to reach it from other devices or when running in a container.
# HOST=127.0.0.1
